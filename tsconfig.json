{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "types": ["bun"],
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true
    },
    "include": ["discord-general-bot.ts", "src/**/*.ts", "plugins/**/*.ts", "tests/**/*.ts"]
}
